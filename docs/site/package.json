{
  "name": "dottod-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "author": {
    "name": "Lucas Vidor Migotto",
    "email": "lvmigotto1@gmail.com",
    "url": "https://lucasvmigotto.me"
  },
  "homepage": "https://docs.lucasvmigotto.me/dottod/",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "og": "bun run scripts/og-image.ts",
    "demos": "vhs tapes/bootstrap-help.tape && vhs tapes/status-commands.tape",
    "llms": "bun run scripts/build-llms.ts",
    "doctor": "bun --version && bunx tsc --version"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@fontsource/ibm-plex-sans": "^5.2.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.7.0",
    "vite": "^8.1.0",
    "vitest": "^3.0.0",
    "vitest-axe": "^0.1.0"
  }
}
