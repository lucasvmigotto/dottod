# Origin of the deployed docs site, used for canonical and Open Graph URLs.
# Overridden in CI by VITE_SITE_URL, derived from the repository name.
VITE_SITE_URL=https://docs.lucasvmigotto.me/dottod
# Build base path. Overridden in CI by VITE_BASE_PATH (also derived from the
# repository name), so the built site lives under the hub prefix /dottod/.
VITE_BASE_PATH=/dottod/
